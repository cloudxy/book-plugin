#!/bin/sh
# 私有内容守卫：书稿原文、蒸馏产物与可重建运行件绝不进仓库（.gitignore 之外再兜一道）
blocked='books .work .venv tools .dsh'
fail=0
for f in $(git diff --cached --name-only); do
  for b in $blocked; do
    case "$f" in
      "$b"|"$b"/*) echo "🔴 拦截：$f 属私有/可重建内容（$b/）——已列入 .gitignore，勿提交"; fail=1 ;;
    esac
  done
done
exit $fail
